{
  "name": "smartumc-functions",
  "private": true,
  "description": "Trusted backend foundation for the SmartUMC DIT demonstration.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "validate": "npm run build",
    "test:rules": "node scripts/verify-firestore-rules.mjs",
    "test": "npm run build && node --test scripts/authentication.test.cjs",
    "test:emulator": "npm run build && node --test scripts/auth-emulator.test.cjs",
    "provision:demo-user": "node scripts/provision-demo-user.cjs"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}

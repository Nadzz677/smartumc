rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users may retrieve only their own profile. Firebase Authentication alone
    // does not grant access to any other application data.
    match /users/{uid} {
      allow get: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.active == true
        && request.auth.token.role in ['student', 'lecturer', 'super_admin'];
      allow list: if false;
      allow create, update, delete: if false;
    }

    // All other collections remain closed until their access matrix is
    // approved and tested. Client-provided roles are never trusted.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
